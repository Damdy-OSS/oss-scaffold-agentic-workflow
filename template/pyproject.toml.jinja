[project]
name = "{{ project_slug }}"
version = "{{ initial_version }}"
description = "{{ project_description }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
license = { text = "{{ license }}" }
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = []

[project.urls]
Homepage = "{{ project_url }}"
Repository = "https://github.com/{{ github_org }}/{{ project_slug }}"
Documentation = "https://{{ github_org }}.github.io/{{ project_slug }}"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug | replace('-','_') }}"]

[tool.uv]
dev-dependencies = [
  "pytest>=8",
  "pytest-cov>=5",
  "pytest-asyncio>=0.23",
  "ruff>=0.9",
  "mypy>=1.10",
  "pyright>=1.1",
  "commitizen>=3",
  "pip-audit>=2",
  "radon>=6",
  "safety>=3",
  "pre-commit>=3",
{% if use_mkdocs %}
  "mkdocs-material>=9",
  "mkdocstrings[python]>=0.27",
{% endif %}
]

[tool.ruff]
target-version = "py{{ python_version | replace('.','') }}"
line-length = 100
src = ["src"]

[tool.ruff.lint]
select = [
    "E", "F", "I", "UP", "B", "SIM", "ANN", "D", "ARG", "PTH", "RET", "RUF", "TID"
]
ignore = [
    "E501", # Line too long (handled by formatter)
    "D100", # Missing docstring in public module
    "D104", # Missing docstring in public package
    "ANN101", # Missing type annotation for self
    "ANN102", # Missing type annotation for cls
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
warn_unreachable = true
pretty = true
show_error_codes = true

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
addopts = "--tb=short --cov=src/{{ project_slug | replace('-','_') }} --cov-report=term-missing --cov-fail-under=80"

[tool.commitizen]
name = "cz_conventional_commits"
version = "{{ initial_version }}"
tag_format = "v$version"
update_changelog_on_bump = true
changelog_file = "CHANGELOG.md"

